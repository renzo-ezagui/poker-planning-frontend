# Vite build-time variables (baked into the bundle at build time).
# Absolute URL of the backend, or a same-origin path like /api behind a reverse proxy.
VITE_API_URL=http://localhost:3000
# Socket.IO endpoint; "/" means "same origin as the page".
VITE_SOCKET_URL=http://localhost:3000
# Optional public URL used in invite links and QR codes.
VITE_PUBLIC_URL=
